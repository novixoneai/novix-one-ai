<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite actual files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Routes below are auto-generated by scripts/prerender-static.ts from
  # src/lib/seo.ts's ROUTE_META at build time — do not edit by hand.
  # Anything not listed here (i.e. not a real file/dir and no rule below)
  # falls through to Apache's native 404, handled by ErrorDocument below.
  # BEGIN GENERATED SPA ROUTES
  # END GENERATED SPA ROUTES
</IfModule>

# Real 404 status for unknown routes (not a soft 404 disguised as 200).
# 404.html still boots the SPA so visitors see the app's own NotFound page.
ErrorDocument 404 /404.html
